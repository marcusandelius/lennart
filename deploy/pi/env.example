# Mall för ~/.config/lennart/.env på Raspberry Pi:n.
# Kopiera till Pi:n, fyll i värdena där, och committa ALDRIG den ifyllda filen.
# Nycklarna nedan är exempel och justeras när appens behov är klara.

# Adressen till webbdelen på Coolify (domänen är inte köpt än)
LENNART_SERVER_URL=

# Delad nyckel så att servern vet att anropet kommer från din Pi
LENNART_DEVICE_TOKEN=
