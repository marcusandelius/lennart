# Mall för ~/.config/lennart/.env på Raspberry Pi:n.
# Kopiera till Pi:n, fyll i värdena där, och committa ALDRIG den ifyllda filen.
# Nycklarna nedan är exempel och justeras när appens behov är klara.

# Adressen till webbdelen på Coolify
LENNART_SERVER_URL=https://lennart.cam

# Delad nyckel så att servern vet att anropet kommer från din Pi.
# Skapa med: openssl rand -hex 32. Samma värde som LENNART_DEVICE_TOKEN i Coolify.
LENNART_DEVICE_TOKEN=

# Valfria inställningar för skärm och kamera (se docs/koppling-display.md)
# LCD_ROTATION=90
# LCD_BGR=0
# LCD_SPI_HZ=32000000
# CAMERA_FLIP=0       (rotationen ställs hellre in i adminvyn)
# SERVO_I2C_BUS=1     (letas upp automatiskt)
